@model List<Assignment1.Models.Event>

<!DOCTYPE html>
<html>
<head>
    <title>Event Manager</title>
</head>
<body>
    <h1>Event Manager</h1>
    <a href="/events/create">Create New Event</a>
    <table>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th></th>
        </tr>
        @foreach (var ev in Model)
        {
            <tr>
                <td>@ev.Title</td>
                <td>@ev.Date.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@ev.Location</td>
                <td>
                    <a href="/events/details/@ev.Id">Details</a> |
                    <a href="/events/edit/@ev.Id">Edit</a> |
                    <a href="/events/delete/@ev.Id">Delete</a> |
                    <a href="/events/@ev.Id/attendees">Attendees</a>
                </td>
            </tr>
        }
    </table>
</body>
</html>