@model Assignment1.Models.Event

<!DOCTYPE html>
<html>
<head>
    <title>Create Event</title>
</head>
<body>
    <h1>Create Event</h1>
    <form method="POST" action="/events/create" enctype="multipart/form-data">
        <label>Title</label>
        <br />
        <input asp-for="Title" />
        <br /><br />

        <label>Description</label>
        <br />
        <textarea asp-for="Description"></textarea>
        <br /><br />

        <label>Date</label>
        <br />
        <input asp-for="Date" type="datetime-local" />
        <br /><br />

        <label>Location</label>
        <br />
        <input asp-for="Location" />
        <br /><br />

        <label>Banner Image</label>
        <br />
        <input type="file" name="bannerFile" accept="image/*" />
        <br /><br />

        <button type="submit">Create</button>
        <a href="/events">Back to List</a>
    </form>
</body>
</html>